# Public site origin
NEXT_PUBLIC_SITE_URL=https://gentlecarenursing.com.au

# Optional analytics: disabled until the correct property and privacy settings are verified.
# See docs/SEO_SCRIPT_OWNERSHIP.md before enabling. Both values are required.
# Existing live measurement must not be silently interrupted: the production build
# requires the documented preservation or owner-approved pause review.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Resend: server-only email delivery for care enquiries and private feedback.
# Never use NEXT_PUBLIC_ for the API key. Configure only through approved secure setup.
RESEND_API_KEY=
REVIEW_FEEDBACK_FROM_EMAIL=noreply@gentlecarenursing.com.au
